```cpp
// TPSCharacter.cpp
void ATPSCharacter::Fire()
{
    if (CurrentWeapon)
    {
        CurrentWeapon->ApplyRecoil();
        CurrentWeapon->FireProjectile();
    }
}

void ATPSCharacter::OnHit(AActor* HitActor, const FHitResult& Hit)
{
    if (HitActor && HitActor->IsA<ATPSEnemy>())
    {
        UGameplayStatics::ApplyDamage(
            HitActor,
            50.0f,
            GetController(),
            this,
            UFireDamage::StaticClass()
        );
    }
}
