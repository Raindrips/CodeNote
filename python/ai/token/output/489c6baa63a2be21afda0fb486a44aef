void UMH_AnimBlueprint::SwitchToFightPose()
{
    // 1. 播放战斗动画
    PlayAnimation(MH_Fight, 1.0f);
    
    // 2. 启用战斗IK
    EnableIK("Fight_IK");
    
    // 3. 设置Root Motion
    SetRootMotion("Fight_RootMotion");
    
    // 4. 物理交互
    PhysicsSimulation->SetFightMode(true);
}
