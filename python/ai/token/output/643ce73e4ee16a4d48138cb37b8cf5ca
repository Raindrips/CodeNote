## 二、核心模块实现

### 1. 随机地图生成（程序化生成算法）
```gd
# Room.gd
extends Node2D

export var width: int = 10
export var height: int = 10
export var min_size: int = 6
export var max_size: int = 12
export var room_count: int = 10

var rooms = []
var corridors = []

func _ready():
    generate_rooms()
    connect_corridors()
    build_map()

func generate_rooms():
    for i in range(room_count):
        var size = randi_range(min_size, max_size)
        var pos = Vector2(randi_range(0, 100), randi_range(0, 100))
        var new_room = Room.new()
        new_room.init(pos, size)
        rooms.append(new_room)
        # 检查房间碰撞
        for r in rooms:
            if new_room.intersects(r):
                rooms.remove(i)
                i -= 1
                break

func connect_corridors():
    for i in range(rooms.size() - 1):
        var a = rooms[i]
        var b = rooms[i+1]
        var corridor = Corridor.new()
        corridor.connect(a.center, b.center)
        corridors.append(corridor)

func build_map():
    var tile_map = get_node("/root/Main/TileMap")
    for room in rooms:
        for x in range(room.size.x):
            for y in range(room.size.y):
                tile_map.set_cell(0, room.position + Vector2(x, y), 1)
    
    for corridor in corridors:
        for pos in corridor.path:
            tile_map.set_cell(0, pos, 1)
```

**性能优化技巧：**
- 使用`tile_map.set_cell()`批量设置时，建议使用`tile_map.set_cells()`方法
- 通过`tile_map.set_size()`预分配空间减少重绘
- 使用`tile_map.set_cell_flags()`设置碰撞属性

**常见问题：**
- 房间重叠：添加碰撞检测逻辑（`intersects()`方法）
- 地图过大：限制房间数量和尺寸范围
- 碰撞检测失效：确保TileMap使用正确的碰撞层设置

