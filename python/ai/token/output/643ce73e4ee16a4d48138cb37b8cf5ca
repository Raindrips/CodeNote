### 2. A*寻路系统
```gd
# Pathfinding.gd
extends Node2D

var grid = []
var tile_map = null
var pathfinding = null

func _ready():
    tile_map = get_node("/root/Main/TileMap")
    pathfinding = tile_map.get_pathfinding()
    # 初始化网格
    for y in range(tile_map.get_size().y):
        grid.append([])
        for x in range(tile_map.get_size().x):
            grid[y].append(0 if tile_map.get_cell(0, Vector2(x, y)) == -1 else 1)

func find_path(start_pos: Vector2, end_pos: Vector2) -> Array:
    var open_list = PriorityQueue.new()
    var closed_list = Dictionary()
    
    # 初始化起点
    var start_node = Node2D.new()
    start_node.position = start_pos
    start_node.g = 0
    start_node.h = get_heuristic(start_pos, end_pos)
    start_node.f = start_node.g + start_node.h
    
    open_list.push(start_node, start_node.f)
    
    while open_list.size() > 0:
        var current = open_list.pop()
        if current.position == end_pos:
            return reconstruct_path(current)
            
        closed_list[current.position] = true
        
        for direction in [Vector2.RIGHT, Vector2.LEFT, Vector2.UP, Vector2.DOWN]:
            var neighbor = current.position + direction
            if is_valid(neighbor) and not closed_list.has(neighbor):
                var new_g = current.g + 1
                var new_h = get_heuristic(neighbor, end_pos)
                var new_node = Node2D.new()
                new_node.position = neighbor
                new_node.g = new_g
                new_node.h = new_h
                new_node.f = new_g + new_h
                new_node.parent = current
                
                if not open_list.has(new_node):
                    open_list.push(new_node, new_node.f)
    
    return []

func get_heuristic(a: Vector2, b: Vector2) -> int:
    return abs(a.x - b.x) + abs(a.y - b.y)

func is_valid(pos: Vector2) -> bool:
    return pos.x >= 0 and pos.y >= 0 and pos.x < tile_map.get_size().x and pos.y < tile_map.get_size().y and grid[pos.y][pos.x] == 0

func reconstruct_path(node: Node2D) -> Array:
    var path = []
    while node:
        path.append(node.position)
        node = node.parent
    return path.reversed()
```

**性能优化：**
- 使用双向A*算法优化长距离寻路
- 对网格进行空间分区处理
- 使用缓存机制存储已计算路径

**进阶技巧：**
- 实现动态障碍物处理
- 添加斜角移动支持
- 使用二叉堆优化优先队列

