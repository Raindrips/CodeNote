**进阶代码示例（多线程寻路）：**
```csharp
[RequireComponent(typeof(NavMeshAgent))]
public class MultiThreadedChase : MonoBehaviour
{
    private NavMeshAgent agent;
    private NavMeshPath path;
    
    void Start()
    {
        agent = GetComponent<NavMeshAgent>();
        path = new NavMeshPath();
    }
    
    void Update()
    {
        if (agent.pathPending) return;
        
        // 使用Job System异步计算路径
        NavMeshPathJob job = new NavMeshPathJob
        {
            agent = agent,
            path = path
        };
        
        job.Schedule();
    }
}
```

