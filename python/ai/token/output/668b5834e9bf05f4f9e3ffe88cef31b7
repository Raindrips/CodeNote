## 十、完整项目结构示例
```csharp
// EnemyManager.cs
public class EnemyManager : MonoBehaviour
{
    public List<EnemyAgent> enemies;
    private NavMeshPool navMeshPool;
    
    void Start()
    {
        navMeshPool = FindObjectOfType<NavMeshPool>();
        foreach (EnemyAgent enemy in enemies)
        {
            NavMeshAgent agent = navMeshPool.GetAgent();
            agent.transform.position = enemy.transform.position;
            agent.GetComponent<EnemyAgent>().Initialize(enemy);
        }
    }
    
    void Update()
    {
        // 实时监控敌人状态
        foreach (EnemyAgent enemy in enemies)
        {
            if (enemy.IsPlayerDetected)
            {
                enemy.Blackboard.SetVariable("CurrentState", "Chase");
            }
        }
    }
}
```

